# Copy to .env and fill in what you need.
# Everything is optional: with no configuration the API still starts and
# returns a rule-based referee explanation.

# --- Azure OpenAI (optional) ----------------------------------------------
# When all four are set, the referee decision is written by an LLM.
# When any is missing, a deterministic rule-based explanation is used instead.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Paths ------------------------------------------------------------------
# Defaults resolve relative to the backend/ directory, so these rarely need changing.
# FOUL_MODEL_PATH=./pretrained_models/20250129_195031/foul_detection_model.pth
# FOUL_BASE_DIR=./data/dataset
# FOUL_DATA_ROOT=./data

# --- Server -----------------------------------------------------------------
# Bind address. 127.0.0.1 keeps the API local-only; use 0.0.0.0 to reach it
# from other machines, and then add their origin to CORS_ORIGINS.
HOST=127.0.0.1
PORT=5000
# Comma-separated. Use * to disable the CORS middleware entirely.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CONTENT_LENGTH_MB=100

# --- Behaviour --------------------------------------------------------------
# Set to false to refuse to start without a trained checkpoint.
ALLOW_UNTRAINED_FALLBACK=true
# Feature backbone: r3d_18 (default, matches training), mc3_18, r2plus1d_18, s3d.
FEATURE_MODEL_TYPE=r3d_18
# Seed for the untrained fallback, so demo output is reproducible.
FALLBACK_SEED=0

# --- Dataset download (training only) ---------------------------------------
# Required only by backend/data/loading/mvfouls-download.py
# SOCCERNET_PASSWORD=
